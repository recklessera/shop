generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String   @id @default(uuid())
  name            String?
  email           String   @unique
  password_hash   String?  // Handled by Supabase Auth
  auth_provider   String   // Google/Apple/Email
  role            String   @default("Customer") // Admin, Customer
  saved_addresses Json?    // JSONB format
  created_at      DateTime @default(now())
  orders          Order[]
}

model StoreSettings {
  id                    String  @id @default(uuid())
  theme_primary_color   String?
  theme_secondary_color String?
  theme_accent_color    String?
  homepage_banner_url   String?
  contact_email         String?
  instagram_url         String?
  twitter_url           String?
  tiktok_url            String?
  whatsapp_number       String?
}

model DiscountCode {
  id                       String    @id @default(uuid())
  code_string              String    @unique
  discount_type            String    // PERCENT/FIXED
  discount_value           Float    
  valid_until              DateTime?
  usage_limit              Int?     
  times_used               Int       @default(0)
  min_order_value          Float?   
  applicable_collection_id String?  
  is_active                Boolean   @default(true)
}

model Collection {
  id               String    @id @default(uuid())
  title            String   
  slug             String    @unique
  description      String?
  cover_image_url  String?  
  banner_image_url String?  
  products         Product[]
}

model Product {
  id            String         @id @default(uuid())
  title         String        
  slug          String         @unique
  sku           String         @unique
  description   String        
  price         Float         
  stock_count   Int            @default(0)
  collection_id String        
  collection    Collection     @relation(fields: [collection_id], references: [id])
  is_published  Boolean        @default(false)
  images        ProductImage[]
  orderItems    OrderItem[]
}

model ProductImage {
  id         String  @id @default(uuid())
  product_id String 
  product    Product @relation(fields: [product_id], references: [id])
  image_url  String 
  alt_text   String?
  is_primary Boolean @default(false)
}

model Order {
  id                    String      @id @default(uuid())
  customer_id           String     
  customer              User        @relation(fields: [customer_id], references: [id])
  total_amount          Float      
  discount_code_id      String?    
  status                String      @default("Pending")
  shipping_address      Json       
  squad_transaction_ref String?    
  items                 OrderItem[]
}

model OrderItem {
  id                String  @id @default(uuid())
  order_id          String 
  order             Order   @relation(fields: [order_id], references: [id])
  product_id        String 
  product           Product @relation(fields: [product_id], references: [id])
  quantity          Int    
  price_at_purchase Float  
}

model Gallery {
  id         String  @id @default(uuid())
  image_url  String 
  caption    String?
  category   String?
  sort_order Int     @default(0)
}

model Blog {
  id                 String    @id @default(uuid())
  title              String   
  slug               String    @unique
  content            String    // HTML/Markdown
  author_id          String   
  featured_image_url String?  
  published_at       DateTime?
  status             String    @default("Draft")
}