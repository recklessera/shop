generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String   @id @default(uuid())
  name            String?
  email           String   @unique
  phone_number    String?  // NEW: Added phone number
  password_hash   String?  
  auth_provider   String   
  role            String   @default("Customer") 
  saved_addresses Json?    
  created_at      DateTime @default(now())
  orders          Order[]
  blogs           Blog[]
}

model StoreSettings {
  id                    String  @id @default(uuid())
  theme_primary_color   String?
  theme_secondary_color String?
  theme_accent_color    String?
  homepage_banner_url   String?
  contact_email         String?
  instagram_url         String?
  twitter_url           String?
  tiktok_url            String?
  whatsapp_number       String?
}

model DiscountCode {
  id                       String    @id @default(uuid())
  code_string              String    @unique
  discount_type            String    // PERCENT/FIXED
  discount_value           Float    
  valid_until              DateTime?
  usage_limit              Int?     
  times_used               Int       @default(0)
  min_order_value          Float?   
  applicable_collection_id String?  
  is_active                Boolean   @default(true)
}

model Collection {
  id               String    @id @default(uuid())
  title            String    
  slug             String    @unique
  description      String?
  cover_image_url  String?  
  banner_image_url String?  
  products         Product[]
}

model Product {
  id            String           @id @default(uuid())
  title         String        
  slug          String           @unique
  description   String        
  price         Float         
  collection_id String        
  collection    Collection       @relation(fields: [collection_id], references: [id])
  is_published  Boolean          @default(false)
  
  images        ProductImage[]
  variants      ProductVariant[] // NEW: Products now have many variants
  orderItems    OrderItem[]      // Kept so we can easily query all orders for a parent product
}

model ProductVariant {
  id          String      @id @default(uuid())
  product_id  String
  product     Product     @relation(fields: [product_id], references: [id], onDelete: Cascade)
  sku         String      @unique
  size        String?     // e.g. "S", "M", "L"
  color       String?     // e.g. "Black", "Crimson"
  stock_count Int         @default(0)
  
  price       Float?      // NEW: Optional override price. If null, it inherits the parent product's price.
  
  orderItems  OrderItem[]
}

model ProductImage {
  id         String  @id @default(uuid())
  product_id String 
  product    Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  image_url  String 
  alt_text   String?
  is_primary Boolean @default(false)
}

model Order {
  id                    String      @id @default(uuid())
  customer_id           String     
  customer              User        @relation(fields: [customer_id], references: [id])
  phone_number          String?
  total_amount          Float      
  discount_code_id      String?    
  status                String      @default("pending")
  shipping_address      Json       
  squad_transaction_ref String?    
  created_at            DateTime    @default(now())
  items                 OrderItem[]
}

model OrderItem {
  id                String          @id @default(uuid())
  order_id          String
  order             Order           @relation(fields: [order_id], references: [id], onDelete: Cascade)
  
  product_id        String
  product           Product         @relation(fields: [product_id], references: [id])
  
  // NEW: Link the order to the specific variant
  variant_id        String?
  variant           ProductVariant? @relation(fields: [variant_id], references: [id])
  
  // NEW: Snapshot the variant data so historical receipts don't break if you delete a variant
  variant_snapshot  String?         // e.g., "Color: Black | Size: M"
  
  quantity          Int    
  price_at_purchase Float  
}

model Gallery {
  id         String  @id @default(uuid())
  image_url  String 
  caption    String?
  category   String?
  sort_order Int     @default(0)
}

model Blog {
  id                 String    @id @default(uuid())
  title              String    
  slug               String    @unique
  content            String    // HTML/Markdown
  author_id          String    
  author             User      @relation(fields: [author_id], references: [id])
  featured_image_url String?  
  published_at       DateTime?
  status             String    @default("draft")
}